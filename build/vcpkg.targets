<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets" Condition="Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets')" />
  <Target Name="JaangleCheckVcpkg" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(VcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets')"
           Text="vcpkg not found. Install the 'vcpkg package manager' Visual Studio component or set VCPKG_ROOT." />
  </Target>
</Project>
